{
  "command": "node",
  "args": ["server.mjs"],
  "restart_policy": "always",
  "display_name": "Context & Cache Monitor",
  "description": "Live dashboard for Gemini context compaction (CHECKPOINT), prefix cache hit rate, and token usage.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Context & Cache Monitor",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Context & Cache"
      }
    ]
  }
}
